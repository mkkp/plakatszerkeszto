<label for="form_title" class="input-label-text"><%= strings.fields.title %></label>
<input type="text" id="form_title" />
<label for="form_subtitle" class="input-label-text"><%= strings.fields.subtitle %></label>
<input type="text" id="form_subtitle" />
<label for="form_date" class="input-label-text"><%= strings.fields.date %></label>
<input type="text" id="form_date" />
<label for="form_address" class="input-label-text"><%= strings.fields.address %></label>
<input type="text" id="form_address" />

<div id="bg_switch" class="switch bg-switch">
    <span id="btn_bg_default" class="checked"><%= strings.defaultBackgrounds %></span>
    <span id="btn_bg_custom"><%= strings.uploadImage %></span>
</div>

<div class="background-scroll-container">
    <div id="background-defaults">
        <% for (let i = 0; i < backgrounds.length; i++) { %>
            <div class="bg_item" data-index="<%= i %>">
                <img src="<%= backgrounds[i].thumb %>">
            </div>
        <% } %>
    </div>
</div>

<div id="background-custom">
    <input type="file" id="form_custom_bg" />

    <div style="font-style:italic;margin-top:10px;"><%= strings.usePNGimage %></div>

    <span class="input-label-text"><%= strings.textColor %></span>

    <div class="radio-button-group">
        <div id="text-black-radio" class="radio-button text-color-radio">
            <i class="fa fa-dot-circle-o"></i>
            <div><%= strings.black %></div>
        </div>
        <div id="text-white-radio" class="radio-button text-color-radio">
            <i class="fa fa-circle-o"></i>
            <div><%= strings.white %></div>
        </div>
    </div>

    <div class="checkbox-group">
        <div id="text-white-bg-checkbox" class="checkbox">
            <i class="fa fa-check-square"></i>
            <div><%= strings.textWhiteBg %></div>
        </div>
    </div>
</div>

<div class="save-buttons">
    <button id="btn_save_event_cover" class="save-btn"><i class="fa fa-download"></i> <%= strings.download %></button>
</div>
